<title>Statistics Study Lab</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: sticky tab bar over three views (roadmap, calculators, quiz). Roadmap is a vertical run of numbered topics; tools are cards in a responsive grid. */
:root{
  --bg:#F2F4F6; --surface:#FFFFFF; --ink:#16202A; --muted:#566370; --line:#D8DEE4;
  --accent:#8C1D2F; --accent-ink:#FFFFFF; --soft:#F4E9EB;
  --good:#1B7A4B; --good-soft:#E3F2EA; --bad:#B3261E; --bad-soft:#FBE7E5;
  --chart:#8C1D2F; --chart2:#B8892B; --chart-fill:rgba(140,29,47,.26); --bardim:#C5CCD4;
  --display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --body:'IBM Plex Sans','Segoe UI',system-ui,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#121418; --surface:#1B1E24; --ink:#E8EAED; --muted:#9AA3AE; --line:#2C323A;
  --accent:#E58A98; --accent-ink:#1B0A0E; --soft:#2A1B1F;
  --good:#5CC28A; --good-soft:#172A21; --bad:#F08A82; --bad-soft:#321C1A;
  --chart:#E58A98; --chart2:#D9B25C; --chart-fill:rgba(229,138,152,.32); --bardim:#3A414B; color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#121418; --surface:#1B1E24; --ink:#E8EAED; --muted:#9AA3AE; --line:#2C323A;
  --accent:#E58A98; --accent-ink:#1B0A0E; --soft:#2A1B1F;
  --good:#5CC28A; --good-soft:#172A21; --bad:#F08A82; --bad-soft:#321C1A;
  --chart:#E58A98; --chart2:#D9B25C; --chart-fill:rgba(229,138,152,.32); --bardim:#3A414B; color-scheme:dark;}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:15px/1.55 var(--body);
  padding-block:0;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
h1,h2,h3,h4{font-family:var(--display);margin:0;text-wrap:balance;line-height:1.15}
p{margin:0}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--bg);border-bottom:1px solid var(--line)}
.top-in{max-width:1040px;margin:0 auto;display:flex;flex-wrap:wrap;gap:8px 20px;align-items:center;justify-content:space-between;padding-block:10px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);font:700 18px var(--display)}
.mark{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font:700 17px var(--display)}
#nav{display:flex;flex-wrap:wrap;gap:4px}
#nav a{padding:6px 12px;border-radius:999px;text-decoration:none;color:var(--muted);font-weight:500}
#nav a[aria-current="page"]{background:var(--accent);color:var(--accent-ink)}
#nav a:not([aria-current="page"]):hover{background:var(--soft);color:var(--accent)}

main{max-width:1040px;margin:0 auto;padding-block:24px 56px}
.view[hidden]{display:none!important}
.eyebrow{font:500 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.hero{display:flex;flex-wrap:wrap;gap:16px 40px;align-items:flex-end;justify-content:space-between;margin-bottom:28px}
.hero h1{font-size:clamp(28px,5vw,44px);margin-top:6px}
.hero p.lede{max-width:56ch;color:var(--muted);margin-top:10px}
.overall{min-width:220px;flex:0 1 260px}
.overall b{font:700 30px var(--display);font-variant-numeric:tabular-nums}
.overall span{color:var(--muted)}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--accent);transition:width .25s}

.topic{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:14px}
.t-head{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center}
.roman{font:700 34px var(--display);color:var(--accent);min-width:2.2ch}
.t-title{flex:1 1 220px;min-width:0}
.t-title h2{font-size:21px}
.meta{font:400 13px var(--mono);color:var(--muted);margin-top:4px}
.t-prog{flex:0 1 140px;min-width:110px;font:500 13px var(--mono);color:var(--muted)}
.t-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:18px 28px;margin-top:16px}
.t-body>div{min-width:0}
.t-body h4{font:500 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.checks{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.checks label{display:flex;gap:9px;align-items:flex-start;cursor:pointer}
.checks input{margin-top:4px;accent-color:var(--accent);width:16px;height:16px;flex:none}
.checks .letter{font:500 12px var(--mono);color:var(--muted);margin-top:3px;flex:none}
.checks input:checked ~ .lt{color:var(--muted);text-decoration:line-through}
ol.out-list{margin:0;padding-left:1.2em;display:grid;gap:6px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.tag{border:1px solid var(--line);border-radius:6px;padding:2px 8px;font-size:13px;background:var(--bg)}
.t-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
.midterm{display:flex;align-items:center;gap:14px;margin:22px 0;font:500 13px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
.midterm::before,.midterm::after{content:"";flex:1;border-top:2px dashed var(--accent);opacity:.5}

.btn{display:inline-block;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);padding:8px 14px;border-radius:8px;font:600 14px var(--body);text-decoration:none;cursor:pointer}
.btn:hover{filter:brightness(1.08)}
.btn.ghost{background:transparent;color:var(--accent)}
.btn.ghost:hover{background:var(--soft);filter:none}

.chips{display:flex;flex-wrap:wrap;gap:6px;margin:16px 0 20px}
.chip{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:6px 12px;font:500 13px var(--body);cursor:pointer}
.chip small{font:400 11px var(--mono);color:var(--muted);margin-left:4px}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.chip[aria-pressed="true"] small{color:var(--accent-ink);opacity:.85}

.tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:14px;align-items:start}
.tool{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;min-width:0}
.tool[hidden]{display:none!important}
.tool.full{grid-column:1/-1}
.tool h3{font-size:18px}
.hint{color:var(--muted);font-size:13.5px;margin:4px 0 12px}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;align-items:end;margin-bottom:12px}
.f{display:grid;gap:4px;min-width:0}
.f.wide{grid-column:1/-1}
.f span{font-size:12.5px;color:var(--muted)}
.f[hidden]{display:none!important}
input,select,textarea{width:100%;min-width:0;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font:16px var(--mono)}
select{font-family:var(--body)}
textarea{resize:vertical;line-height:1.5}
.sub{font:500 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:14px 0 8px;padding-top:12px;border-top:1px solid var(--line)}
.results{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:8px;margin-bottom:10px}
.res{border:1px solid var(--line);border-radius:8px;padding:7px 10px;min-width:0;background:var(--bg)}
.res span{display:block;font-size:12px;color:var(--muted)}
.res b{font:500 16px var(--mono);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.res.key{background:var(--soft);border-color:var(--accent)}
.res.key b{color:var(--accent)}
.warn{color:var(--bad);font-size:14px}
.steps{margin:8px 0 0;padding-left:1.2em;display:grid;gap:4px;font-size:13.5px;color:var(--muted)}
.steps code,.note code{font-family:var(--mono);color:var(--ink)}
.verdict{border-radius:8px;padding:10px 12px;font-weight:500;margin-top:6px}
.verdict.rej{background:var(--bad-soft);color:var(--bad)}
.verdict.keep{background:var(--good-soft);color:var(--good)}
.note{font-size:13.5px;color:var(--muted);margin-top:6px}
canvas{display:block;width:100%;height:190px;margin-top:6px}
.tbl{overflow-x:auto;margin-bottom:8px}
table{border-collapse:collapse;font:13px var(--mono);font-variant-numeric:tabular-nums;width:100%}
th,td{border:1px solid var(--line);padding:5px 9px;text-align:right;white-space:nowrap}
th{background:var(--bg);font-weight:500;color:var(--muted)}
td:first-child,th:first-child{text-align:left}
tfoot td{font-weight:500;background:var(--bg)}
.idchips{display:flex;flex-wrap:wrap;gap:4px;max-height:150px;overflow:auto}
.idchips span{font:13px var(--mono);border:1px solid var(--line);border-radius:6px;padding:1px 7px;background:var(--bg)}
details summary{cursor:pointer;font:600 15px var(--body);color:var(--accent)}
details .tbl{margin-top:10px;max-height:420px;overflow:auto}
#ztable th:first-child,#ztable td:first-child{position:sticky;left:0;background:var(--bg)}

.quiz{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:20px;max-width:720px}
.q-top{display:flex;justify-content:space-between;gap:10px;font:500 13px var(--mono);color:var(--muted);margin-bottom:12px}
.q-text{font:600 20px var(--display);margin-bottom:16px;text-wrap:pretty}
.opts{display:grid;gap:8px}
.opt{display:flex;gap:10px;text-align:left;width:100%;padding:11px 13px;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:8px;font:15px var(--body);cursor:pointer}
.opt b{font:500 13px var(--mono);color:var(--muted);margin-top:2px}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt:disabled{cursor:default}
.opt.right{border-color:var(--good);background:var(--good-soft)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.explain{margin-top:14px;padding:12px 14px;border-radius:8px;background:var(--soft);font-size:14.5px}
.q-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.score-big{font:700 44px var(--display);color:var(--accent)}

@media (max-width:520px){.t-prog{flex-basis:100%}.quiz{padding:16px}.q-text{font-size:18px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header class="top">
  <div class="top-in">
    <a class="brand" href="#roadmap"><span class="mark">σ</span><span>Statistics Study Lab</span></a>
    <nav id="nav" aria-label="Sections">
      <a href="#roadmap" data-view="roadmap">Roadmap</a>
      <a href="#calculators" data-view="calculators">Calculators</a>
      <a href="#quiz" data-view="quiz">Practice quiz</a>
    </nav>
  </div>
</header>

<main>
<!-- ============ ROADMAP ============ -->
<section id="view-roadmap" class="view">
  <div class="hero">
    <div>
      <div class="eyebrow">Weeks 1–10 · 35 contact hours</div>
      <h1>Statistics course roadmap</h1>
      <p class="lede">Seven topics, from data basics to hypothesis testing. Tick each lesson when you finish it, then open the matching calculator or quiz.</p>
    </div>
    <div class="overall">
      <b id="overall-n">0 / 28</b> <span>lessons done</span>
      <div class="bar"><i id="overall-bar" style="width:0%"></i></div>
    </div>
  </div>
  <div id="roadmap-list"></div>
</section>

<!-- ============ CALCULATORS ============ -->
<section id="view-calculators" class="view" hidden>
  <div class="eyebrow">One set of tools per topic</div>
  <h1 style="font-size:clamp(26px,4.5vw,38px);margin-top:6px">Calculators</h1>
  <div class="chips" id="calc-chips"></div>

  <div class="tools">
    <!-- Topic 1 -->
    <article class="tool full" data-topic="1" id="t-freq">
      <h3>Frequency table and histogram</h3>
      <p class="hint">Paste raw scores. The class width follows Sturges' rule unless you enter your own.</p>
      <div class="form">
        <label class="f wide"><span>Data (separate with spaces or commas)</span>
          <textarea id="freq-data" rows="3">62 75 81 58 90 67 72 85 78 69 74 88 65 71 79 83 60 77 70 92 68 73 80 76 84 66 91 64 82 87</textarea></label>
        <label class="f"><span>Class width (blank = auto)</span><input id="freq-w" type="number" step="any" min="0" placeholder="auto"></label>
      </div>
      <div id="freq-out"></div>
      <canvas id="freq-c" aria-label="Histogram of the data"></canvas>
    </article>
    <article class="tool" data-topic="1" id="t-samp">
      <h3>Draw a sample</h3>
      <p class="hint">Number the population 1 to N, then pick the members to survey.</p>
      <div class="form">
        <label class="f"><span>Population size N</span><input id="samp-N" type="number" min="2" max="1000000" value="500"></label>
        <label class="f"><span>Sample size n</span><input id="samp-n" type="number" min="1" max="1000" value="25"></label>
        <label class="f"><span>Method</span><select id="samp-m"><option value="srs">Simple random</option><option value="sys">Systematic</option></select></label>
        <button class="btn" id="samp-go" type="button">Draw sample</button>
      </div>
      <div id="samp-out"></div>
    </article>

    <!-- Topic 2 -->
    <article class="tool full" data-topic="2" id="t-desc">
      <h3>Central tendency and dispersion</h3>
      <p class="hint">Mean, median, mode, range, variance and standard deviation, with the working shown.</p>
      <div class="form">
        <label class="f wide"><span>Data</span><textarea id="desc-data" rows="2">12 15 11 18 15 20 14 15 17 13</textarea></label>
      </div>
      <div id="desc-out"></div>
    </article>

    <!-- Topic 3 -->
    <article class="tool" data-topic="3" id="t-count">
      <h3>Counting: n!, nPr, nCr</h3>
      <p class="hint">Use permutations when order matters, combinations when it does not.</p>
      <div class="form">
        <label class="f"><span>n (total items)</span><input id="cnt-n" type="number" min="0" max="200" value="8"></label>
        <label class="f"><span>r (chosen)</span><input id="cnt-r" type="number" min="0" max="200" value="3"></label>
      </div>
      <div id="cnt-out"></div>
    </article>
    <article class="tool" data-topic="3" id="t-rules">
      <h3>Probability rules</h3>
      <p class="hint">Enter P(A), P(B) and P(A and B).</p>
      <div class="form">
        <label class="f"><span>P(A)</span><input id="pr-a" type="number" step="any" min="0" max="1" value="0.5"></label>
        <label class="f"><span>P(B)</span><input id="pr-b" type="number" step="any" min="0" max="1" value="0.4"></label>
        <label class="f"><span>P(A and B)</span><input id="pr-ab" type="number" step="any" min="0" max="1" value="0.2"></label>
      </div>
      <div id="pr-out"></div>
    </article>

    <!-- Topic 4 -->
    <article class="tool" data-topic="4" id="t-rv">
      <h3>Discrete random variable</h3>
      <p class="hint">One row per value: x, then P(x). Gives the mean and standard deviation.</p>
      <div class="form">
        <label class="f wide"><span>x, P(x) per line</span><textarea id="rv-data" rows="4">0, 0.2
1, 0.5
2, 0.3</textarea></label>
      </div>
      <div id="rv-out"></div>
    </article>
    <article class="tool" data-topic="4" id="t-binom">
      <h3>Binomial distribution</h3>
      <p class="hint">n independent trials, each with success probability p.</p>
      <div class="form">
        <label class="f"><span>n (trials)</span><input id="bn-n" type="number" min="1" max="100" value="10"></label>
        <label class="f"><span>p (success)</span><input id="bn-p" type="number" step="any" min="0" max="1" value="0.3"></label>
        <label class="f"><span>x (successes)</span><input id="bn-x" type="number" min="0" max="100" value="3"></label>
      </div>
      <div id="bn-out"></div>
      <canvas id="bn-c" aria-label="Binomial probabilities"></canvas>
    </article>
    <article class="tool" data-topic="4" id="t-unif">
      <h3>Continuous uniform distribution</h3>
      <p class="hint">Every value between a and b is equally likely.</p>
      <div class="form">
        <label class="f"><span>a (min)</span><input id="un-a" type="number" step="any" value="0"></label>
        <label class="f"><span>b (max)</span><input id="un-b" type="number" step="any" value="10"></label>
        <label class="f"><span>P(c &lt; X &lt; d): c</span><input id="un-c" type="number" step="any" value="2"></label>
        <label class="f"><span>d</span><input id="un-d" type="number" step="any" value="5"></label>
      </div>
      <div id="un-out"></div>
    </article>

    <!-- Topic 5 -->
    <article class="tool full" data-topic="5" id="t-normal">
      <h3>Normal distribution</h3>
      <p class="hint">Standardize with z = (x − μ) / σ, then read the area under the curve.</p>
      <div class="form">
        <label class="f"><span>Mean μ</span><input id="nm-mu" type="number" step="any" value="70"></label>
        <label class="f"><span>Standard deviation σ</span><input id="nm-sd" type="number" step="any" min="0" value="10"></label>
        <label class="f"><span>Find</span><select id="nm-mode"><option value="below">P(X &lt; x₁)</option><option value="above">P(X &gt; x₁)</option><option value="between" selected>P(x₁ &lt; X &lt; x₂)</option></select></label>
        <label class="f"><span>x₁</span><input id="nm-x1" type="number" step="any" value="60"></label>
        <label class="f" id="nm-x2-wrap"><span>x₂</span><input id="nm-x2" type="number" step="any" value="85"></label>
      </div>
      <div id="nm-out"></div>
      <canvas id="nm-c" aria-label="Normal curve with shaded area" style="height:220px"></canvas>
      <div class="sub">Find x from a percentile</div>
      <div class="form">
        <label class="f"><span>Area to the left (0 to 1)</span><input id="nm-p" type="number" step="any" min="0.0001" max="0.9999" value="0.9"></label>
      </div>
      <div id="nm-inv"></div>
    </article>
    <article class="tool full" data-topic="5" id="t-ztable">
      <details>
        <summary>Standard normal table (Z-table)</summary>
        <p class="hint" style="margin-top:8px">Each cell is P(Z &lt; z). Find the row for the first decimal, then the column for the second. For negative z, use P(Z &lt; −z) = 1 − P(Z &lt; z).</p>
        <div class="tbl"><table id="ztable"></table></div>
      </details>
    </article>

    <!-- Topic 6 -->
    <article class="tool full" data-topic="6" id="t-clt">
      <h3>Central Limit Theorem simulator</h3>
      <p class="hint">Draw many samples from a population and plot each sample mean. The means pile up in a bell shape as n grows, even when the population does not.</p>
      <div class="form">
        <label class="f"><span>Population</span><select id="clt-pop"><option value="uni">Uniform (0 to 100)</option><option value="exp" selected>Right-skewed (exponential)</option><option value="bi">Two peaks (bimodal)</option></select></label>
        <label class="f"><span>Sample size n</span><input id="clt-n" type="number" min="1" max="200" value="30"></label>
        <label class="f"><span>Number of samples</span><input id="clt-k" type="number" min="50" max="5000" value="1000"></label>
        <button class="btn" id="clt-go" type="button">Run again</button>
      </div>
      <div id="clt-out"></div>
      <div class="sub">Population (4,000 random draws)</div>
      <canvas id="clt-c1" aria-label="Population shape"></canvas>
      <div class="sub">Distribution of the sample means</div>
      <canvas id="clt-c2" aria-label="Distribution of sample means"></canvas>
    </article>

    <!-- Topic 7 -->
    <article class="tool" data-topic="7" id="t-ci">
      <h3>Confidence interval for a mean</h3>
      <p class="hint">Point estimate ± margin of error.</p>
      <div class="form">
        <label class="f"><span>Sample mean x̄</span><input id="ci-x" type="number" step="any" value="72.5"></label>
        <label class="f"><span>Std. deviation (s or σ)</span><input id="ci-s" type="number" step="any" min="0" value="8"></label>
        <label class="f"><span>Sample size n</span><input id="ci-n" type="number" min="2" value="36"></label>
        <label class="f"><span>Confidence %</span><input id="ci-c" type="number" step="any" min="50" max="99.9" value="95"></label>
        <label class="f"><span>Use</span><select id="ci-type"><option value="t">t (σ unknown)</option><option value="z">z (σ known)</option></select></label>
      </div>
      <div id="ci-out"></div>
    </article>
    <article class="tool" data-topic="7" id="t-ht">
      <h3>Hypothesis test for a mean</h3>
      <p class="hint">Compare the sample mean with the claimed mean μ₀.</p>
      <div class="form">
        <label class="f"><span>Sample mean x̄</span><input id="ht-x" type="number" step="any" value="74.2"></label>
        <label class="f"><span>Claimed mean μ₀</span><input id="ht-mu" type="number" step="any" value="70"></label>
        <label class="f"><span>Std. deviation (s or σ)</span><input id="ht-s" type="number" step="any" min="0" value="9"></label>
