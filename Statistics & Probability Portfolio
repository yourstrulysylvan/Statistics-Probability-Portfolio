const fmt=(x,d=4)=>{if(x===null||x===undefined||!isFinite(x))return '—';const r=Number(x.toFixed(d));return Object.is(r,-0)?'0':String(r)};
const fmtP=p=>p<0.0001?'< 0.0001':fmt(p,4);
const nums=s=>s.split(/[\s,;]+/).filter(Boolean).map(Number).filter(Number.isFinite);
const val=id=>parseFloat($('#'+id).value);
const res=(l,v,key)=>`<div class="res${key?' key':''}"><span>${l}</span><b>${v}</b></div>`;
const warn=m=>`<p class="warn">${m}</p>`;
const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const cssVar=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();

//#MATH-START
function Phi(x){if(x<-8)return 0;if(x>8)return 1;let s=x,t=x,i=3,p;do{p=s;t*=x*x/i;s+=t;i+=2}while(s!==p);return 0.5+s*Math.exp(-x*x/2)/Math.sqrt(2*Math.PI)}
function invPhi(p){let lo=-10,hi=10;for(let i=0;i<100;i++){const m=(lo+hi)/2;if(Phi(m)<p)lo=m;else hi=m}return (lo+hi)/2}
function lgamma(x){const c=[0.99999999999980993,676.5203681218851,-1259.1392167224028,771.32342877765313,-176.61502916214059,12.507343278686905,-0.13857109526572012,9.9843695780195716e-6,1.5056327351493116e-7];
  if(x<0.5)return Math.log(Math.PI/Math.abs(Math.sin(Math.PI*x)))-lgamma(1-x);
  x-=1;let a=c[0];const t=x+7.5;for(let i=1;i<9;i++)a+=c[i]/(x+i);
  return 0.5*Math.log(2*Math.PI)+(x+0.5)*Math.log(t)-t+Math.log(a)}
function betacf(a,b,x){const FP=1e-300;let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;if(Math.abs(d)<FP)d=FP;d=1/d;let h=d;
  for(let m=1;m<=300;m++){const m2=2*m;let aa=m*(b-m)*x/((qam+m2)*(a+m2));d=1+aa*d;if(Math.abs(d)<FP)d=FP;c=1+aa/c;if(Math.abs(c)<FP)c=FP;d=1/d;h*=d*c;
    aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));d=1+aa*d;if(Math.abs(d)<FP)d=FP;c=1+aa/c;if(Math.abs(c)<FP)c=FP;d=1/d;const del=d*c;h*=del;if(Math.abs(del-1)<3e-12)break}
  return h}
function betai(x,a,b){if(x<=0)return 0;if(x>=1)return 1;
  const bt=Math.exp(lgamma(a+b)-lgamma(a)-lgamma(b)+a*Math.log(x)+b*Math.log(1-x));
  return x<(a+1)/(a+b+2)?bt*betacf(a,b,x)/a:1-bt*betacf(b,a,1-x)/b}
function tCDF(t,df){const x=df/(df+t*t);const p=0.5*betai(x,df/2,0.5);return t>0?1-p:p}
function tInv(p,df){let lo=-2000,hi=2000;for(let i=0;i<200;i++){const m=(lo+hi)/2;if(tCDF(m,df)<p)lo=m;else hi=m}return (lo+hi)/2}
function binPmf(n,p,k){if(k<0||k>n)return 0;if(p===0)return k===0?1:0;if(p===1)return k===n?1:0;
  return Math.exp(lgamma(n+1)-lgamma(k+1)-lgamma(n-k+1)+k*Math.log(p)+(n-k)*Math.log(1-p))}
function fact(n){let r=1n;for(let i=2n;i<=BigInt(n);i++)r*=i;return r}
//#MATH-END

const bigStr=x=>{const s=x.toString();if(s.length>15)return `${s[0]}.${s.slice(1,5)} × 10^${s.length-1}`;return s.replace(/\B(?=(\d{3})+(?!\d))/g,',')};
const randn=()=>{let u=0;while(u===0)u=Math.random();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*Math.random())};

/* ---------- canvas drawing ---------- */
function setupCanvas(c){const dpr=window.devicePixelRatio||1;const w=c.clientWidth,h=c.clientHeight;
  if(!w)return null;
  if(c.width!==Math.round(w*dpr)||c.height!==Math.round(h*dpr)){c.width=Math.round(w*dpr);c.height=Math.round(h*dpr)}
  const g=c.getContext('2d');g.setTransform(dpr,0,0,dpr,0,0);g.clearRect(0,0,w,h);return {g,w,h}}
const axisNum=v=>v>=10?String(Math.round(v)):fmt(v,2);
function barChart(c,labels,vals,hl){
  const S=setupCanvas(c);if(!S)return;const {g,w,h}=S;
  const padL=36,padR=8,padT=10,padB=24;const max=Math.max(...vals,1e-9);
  const muted=cssVar('--muted'),line=cssVar('--line'),c1=cssVar('--chart'),dim=cssVar('--bardim');
  g.font='11px IBM Plex Mono, monospace';g.lineWidth=1;
  for(let i=0;i<=4;i++){const y=padT+(h-padT-padB)*(1-i/4);g.strokeStyle=line;g.beginPath();g.moveTo(padL,y);g.lineTo(w-padR,y);g.stroke();
    g.fillStyle=muted;g.textAlign='right';g.fillText(axisNum(max*i/4),padL-5,y+4)}
  const bw=(w-padL-padR)/vals.length;const step=Math.max(1,Math.ceil(vals.length/Math.floor((w-padL)/42)));
  vals.forEach((v,i)=>{const bh=(h-padT-padB)*v/max;g.fillStyle=hl?(hl(i)?c1:dim):c1;
    g.fillRect(padL+i*bw+Math.min(1,bw*.08),h-padB-bh,Math.max(1,bw-Math.min(2,bw*.16)),bh);
    if(i%step===0){g.fillStyle=muted;g.textAlign='center';g.fillText(labels[i],padL+i*bw+bw/2,h-8)}})}
function drawNormal(c,lo,hi,mu,sd){
  const S=setupCanvas(c);if(!S)return;const {g,w,h}=S;
  const padL=10,padR=10,padT=10,padB=40;
  const X=z=>padL+(z+4)/8*(w-padL-padR),Y=y=>padT+(h-padT-padB)*(1-y/0.42);
  const pdf=z=>Math.exp(-z*z/2)/Math.sqrt(2*Math.PI);
  const a=Math.max(lo,-4),b=Math.min(hi,4);
  if(b>a){g.beginPath();g.moveTo(X(a),Y(0));for(let z=a;z<b;z+=0.02)g.lineTo(X(z),Y(pdf(z)));g.lineTo(X(b),Y(pdf(b)));g.lineTo(X(b),Y(0));g.closePath();g.fillStyle=cssVar('--chart-fill');g.fill()}
  g.beginPath();for(let z=-4;z<=4.0001;z+=0.02){const x=X(z),y=Y(pdf(z));if(z===-4)g.moveTo(x,y);else g.lineTo(x,y)}
  g.strokeStyle=cssVar('--chart');g.lineWidth=2;g.stroke();
  g.strokeStyle=cssVar('--line');g.lineWidth=1;g.beginPath();g.moveTo(padL,Y(0));g.lineTo(w-padR,Y(0));g.stroke();
  g.font='11px IBM Plex Mono, monospace';g.textAlign='center';
  for(let z=-3;z<=3;z++){g.fillStyle=cssVar('--ink');g.fillText((z<0?'−':'')+'z '+Math.abs(z),X(z),h-24);
    if(isFinite(mu)&&isFinite(sd)){g.fillStyle=cssVar('--muted');g.fillText(fmt(mu+z*sd,1),X(z),h-8)}
    g.beginPath();g.moveTo(X(z),Y(0));g.lineTo(X(z),Y(0)+4);g.stroke()}}

