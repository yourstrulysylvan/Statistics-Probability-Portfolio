/* ---------- tools ---------- */
function runFreq(){
  const out=$('#freq-out'),c=$('#freq-c');const d=nums($('#freq-data').value);
  if(d.length<2){out.innerHTML=warn('Enter at least two numbers.');return}
  const n=d.length,mn=Math.min(...d),mx=Math.max(...d),range=mx-mn,isInt=d.every(Number.isInteger);
  const k=Math.ceil(1+3.322*Math.log10(n));
  let w=parseFloat($('#freq-w').value);
  if(!(w>0)){w=range===0?1:isInt?Math.max(1,Math.ceil(range/k)):Math.ceil(range/k*10)/10}
  const nc=Math.floor(range/w+1e-9)+1;
  if(nc>40){out.innerHTML=warn('That makes more than 40 classes. Use a wider class width.');return}
  const f=new Array(nc).fill(0);d.forEach(v=>{f[Math.min(nc-1,Math.floor((v-mn)/w+1e-9))]++});
  const intLab=isInt&&Number.isInteger(w);let cum=0;
  const labs=f.map((_,i)=>{const lo=mn+i*w;return intLab?`${lo}–${lo+w-1}`:`${fmt(lo,2)} to <${fmt(lo+w,2)}`});
  const rows=f.map((v,i)=>{cum+=v;return `<tr><td>${labs[i]}</td><td>${v}</td><td>${fmt(v/n*100,1)}%</td><td>${cum}</td></tr>`}).join('');
  out.innerHTML=`<div class="results">${res('Values (n)',n)}${res('Smallest',fmt(mn))}${res('Largest',fmt(mx))}${res('Classes × width',`${nc} × ${fmt(w,2)}`)}</div>
   <div class="tbl"><table><thead><tr><th>Class</th><th>Frequency</th><th>Relative</th><th>Cumulative</th></tr></thead><tbody>${rows}</tbody><tfoot><tr><td>Total</td><td>${n}</td><td>100%</td><td></td></tr></tfoot></table></div>`;
  barChart(c,f.map((_,i)=>fmt(mn+i*w,1)),f)}

function drawSample(){
  const out=$('#samp-out');const N=Math.floor(val('samp-N')),n=Math.floor(val('samp-n')),m=$('#samp-m').value;
  if(!(N>=2)||!(n>=1)||n>N||n>1000||N>1e6){out.innerHTML=warn('Use 2 ≤ N ≤ 1,000,000 and 1 ≤ n ≤ 1,000, with n not larger than N.');return}
  let ids=[],note;
  if(m==='srs'){const s=new Set();while(s.size<n)s.add(1+Math.floor(Math.random()*N));ids=[...s].sort((a,b)=>a-b);note='Simple random sampling: every member has the same chance of being picked.'}
  else{const k=Math.floor(N/n),st=1+Math.floor(Math.random()*k);for(let i=0;i<n;i++)ids.push(st+i*k);note=`Systematic sampling: interval k = ⌊N / n⌋ = ${k}, random start = ${st}.`}
  out.innerHTML=`<p class="note" style="margin:0 0 8px">${note}</p><div class="idchips">${ids.map(i=>`<span>${i}</span>`).join('')}</div>`}

function runDesc(){
  const out=$('#desc-out');const d=nums($('#desc-data').value);
  if(d.length<2){out.innerHTML=warn('Enter at least two numbers.');return}
  const n=d.length,sum=d.reduce((a,b)=>a+b,0),mean=sum/n,s=[...d].sort((a,b)=>a-b);
  const med=n%2?s[(n-1)/2]:(s[n/2-1]+s[n/2])/2;
  const fq=new Map();d.forEach(v=>fq.set(v,(fq.get(v)||0)+1));const mf=Math.max(...fq.values());
  const modes=mf===1?null:[...fq].filter(([,f])=>f===mf).map(([v])=>v).sort((a,b)=>a-b);
  const ss=d.reduce((a,v)=>a+(v-mean)**2,0),sv=ss/(n-1),sd=Math.sqrt(sv),pv=ss/n,psd=Math.sqrt(pv);
  out.innerHTML=`<div class="results">${res('Mean x̄',fmt(mean),1)}${res('Median',fmt(med),1)}${res('Mode',modes?modes.map(v=>fmt(v)).join(', '):'none',1)}
    ${res('Range',fmt(s[n-1]-s[0]))}${res('Sample SD (s)',fmt(sd),1)}${res('Sample variance s²',fmt(sv))}${res('Population SD (σ)',fmt(psd))}${res('Population variance σ²',fmt(pv))}
    ${res('Count n',n)}${res('Sum Σx',fmt(sum))}${res('Σ(x − x̄)²',fmt(ss))}${res('Coefficient of variation',mean?fmt(sd/Math.abs(mean)*100,2)+'%':'—')}</div>
    <ol class="steps"><li>Mean = Σx ÷ n = <code>${fmt(sum)} ÷ ${n} = ${fmt(mean)}</code></li>
    <li>Median: sort the data, then take the middle value (or average the middle two). Sorted: <code>${s.map(v=>fmt(v)).join(' ')}</code></li>
    <li>Sample variance = Σ(x − x̄)² ÷ (n − 1) = <code>${fmt(ss)} ÷ ${n-1} = ${fmt(sv)}</code>, so s = <code>${fmt(sd)}</code></li>
    <li>Use n − 1 for a sample and n for a whole population.</li></ol>`}

function runCount(){
  const out=$('#cnt-out');const n=Math.floor(val('cnt-n')),r=Math.floor(val('cnt-r'));
  if(!(n>=0)||!(r>=0)||n>200||r>n){out.innerHTML=warn('Use whole numbers with 0 ≤ r ≤ n ≤ 200.');return}
  const P=fact(n)/fact(n-r),C=P/fact(r);
  out.innerHTML=`<div class="results">${res(`${n}!`,bigStr(fact(n)))}${res(`Permutations ${n}P${r}`,bigStr(P),1)}${res(`Combinations ${n}C${r}`,bigStr(C),1)}</div>
   <ol class="steps"><li><code>nPr = n! ÷ (n − r)!</code></li><li><code>nCr = n! ÷ (r! (n − r)!) = nPr ÷ r!</code></li></ol>`}

function runRules(){
  const out=$('#pr-out');const a=val('pr-a'),b=val('pr-b'),ab=val('pr-ab');
  if([a,b,ab].some(v=>!(v>=0&&v<=1))){out.innerHTML=warn('Probabilities must be between 0 and 1.');return}
  if(ab>Math.min(a,b)+1e-9||ab<Math.max(0,a+b-1)-1e-9){out.innerHTML=warn('P(A and B) cannot be larger than the smaller of P(A) and P(B), or smaller than P(A) + P(B) − 1.');return}
  const un=a+b-ab,indep=Math.abs(a*b-ab)<1e-9,mx=ab===0;
  out.innerHTML=`<div class="results">${res('P(A or B)',fmt(un),1)}${res('P(A | B)',b?fmt(ab/b):'—')}${res('P(B | A)',a?fmt(ab/a):'—')}${res('P(not A)',fmt(1-a))}${res('P(not B)',fmt(1-b))}${res('P(neither)',fmt(1-un))}</div>
   <p class="note">Independent: <b>${indep?'yes':'no'}</b> (P(A) × P(B) = ${fmt(a*b)}). Mutually exclusive: <b>${mx?'yes':'no'}</b>.</p>
   <ol class="steps"><li>Addition rule: <code>P(A or B) = P(A) + P(B) − P(A and B) = ${fmt(a)} + ${fmt(b)} − ${fmt(ab)}</code></li><li>Conditional: <code>P(A | B) = P(A and B) ÷ P(B)</code></li></ol>`}

function runRV(){
  const out=$('#rv-out');const rows=$('#rv-data').value.split('\n').map(l=>l.split(/[\s,;]+/).filter(Boolean).map(Number)).filter(r=>r.length>=2&&r.every(Number.isFinite));
  if(rows.length<2){out.innerHTML=warn('Enter at least two lines like “1, 0.5”.');return}
  const sp=rows.reduce((a,r)=>a+r[1],0);
  if(rows.some(r=>r[1]<0||r[1]>1)){out.innerHTML=warn('Each P(x) must be between 0 and 1.');return}
  const E=rows.reduce((a,r)=>a+r[0]*r[1],0),E2=rows.reduce((a,r)=>a+r[0]**2*r[1],0),V=E2-E*E;
  const ok=Math.abs(sp-1)<1e-6;
  out.innerHTML=(ok?'':warn(`The probabilities add to ${fmt(sp)}, not 1. A valid distribution must total exactly 1.`))+
   `<div class="tbl"><table><thead><tr><th>x</th><th>P(x)</th><th>x·P(x)</th><th>x²·P(x)</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${fmt(r[0])}</td><td>${fmt(r[1])}</td><td>${fmt(r[0]*r[1])}</td><td>${fmt(r[0]**2*r[1])}</td></tr>`).join('')}</tbody><tfoot><tr><td>Total</td><td>${fmt(sp)}</td><td>${fmt(E)}</td><td>${fmt(E2)}</td></tr></tfoot></table></div>
   <div class="results">${res('Mean E(X)',fmt(E),1)}${res('Variance',fmt(V))}${res('Std. deviation',fmt(Math.sqrt(Math.max(V,0))),1)}</div>
   <p class="note">Variance = E(X²) − [E(X)]² = ${fmt(E2)} − ${fmt(E*E)}.</p>`}

function runBinom(){
  const out=$('#bn-out'),c=$('#bn-c');const n=Math.floor(val('bn-n')),p=val('bn-p'),x=Math.floor(val('bn-x'));
  if(!(n>=1&&n<=100)||!(p>=0&&p<=1)||!(x>=0&&x<=n)){out.innerHTML=warn('Use 1 ≤ n ≤ 100, 0 ≤ p ≤ 1 and 0 ≤ x ≤ n.');return}
  const pm=Array.from({length:n+1},(_,k)=>binPmf(n,p,k));
  const le=pm.slice(0,x+1).reduce((a,b)=>a+b,0),eq=pm[x];
  out.innerHTML=`<div class="results">${res(`P(X = ${x})`,fmt(eq),1)}${res(`P(X ≤ ${x})`,fmt(le),1)}${res(`P(X < ${x})`,fmt(le-eq))}${res(`P(X ≥ ${x})`,fmt(1-le+eq))}${res(`P(X > ${x})`,fmt(1-le))}
    ${res('Mean np',fmt(n*p))}${res('Variance npq',fmt(n*p*(1-p)))}${res('Std. deviation',fmt(Math.sqrt(n*p*(1-p))))}</div>`;
  barChart(c,pm.map((_,i)=>String(i)),pm,i=>i===x)}

function runUnif(){
  const out=$('#un-out');const a=val('un-a'),b=val('un-b'),c=val('un-c'),d=val('un-d');
  if(![a,b,c,d].every(Number.isFinite)||!(b>a)||!(d>=c)){out.innerHTML=warn('Use b greater than a, and d at least c.');return}
  const lo=Math.max(a,c),hi=Math.min(b,d),p=Math.max(0,hi-lo)/(b-a);
  out.innerHTML=`<div class="results">${res(`P(${fmt(c)} < X < ${fmt(d)})`,fmt(p),1)}${res('Mean (a + b) / 2',fmt((a+b)/2))}${res('Variance (b − a)² / 12',fmt((b-a)**2/12))}${res('Std. deviation',fmt((b-a)/Math.sqrt(12)))}${res('Height 1 / (b − a)',fmt(1/(b-a)))}</div>
   <p class="note">For any continuous variable, P(X = exact value) = 0. Only intervals carry probability.</p>`}

function runNormal(){
  const out=$('#nm-out'),c=$('#nm-c'),mode=$('#nm-mode').value;
  $('#nm-x2-wrap').hidden=mode!=='between';
  const mu=val('nm-mu'),sd=val('nm-sd'),x1=val('nm-x1'),x2=val('nm-x2');
  if(![mu,sd,x1].every(Number.isFinite)||!(sd>0)||(mode==='between'&&!Number.isFinite(x2))){out.innerHTML=warn('Enter μ, a positive σ, and the x values.');return}
  const z1=(x1-mu)/sd,z2=(x2-mu)/sd;let p,lo,hi,txt;
  if(mode==='below'){p=Phi(z1);lo=-Infinity;hi=z1;txt=`P(Z < ${fmt(z1,2)})`}
  else if(mode==='above'){p=1-Phi(z1);lo=z1;hi=Infinity;txt=`P(Z > ${fmt(z1,2)})`}
  else{lo=Math.min(z1,z2);hi=Math.max(z1,z2);p=Phi(hi)-Phi(lo);txt=`P(${fmt(lo,2)} < Z < ${fmt(hi,2)})`}
  out.innerHTML=`<div class="results">${res('z for x₁',fmt(z1,3))}${mode==='between'?res('z for x₂',fmt(z2,3)):''}${res('Probability',fmtP(p),1)}${res('As a percent',fmt(p*100,2)+'%',1)}</div>
   <p class="note"><code>z = (x − μ) / σ</code>, so the area is <code>${txt}</code>.</p>`;
  drawNormal(c,lo,hi,mu,sd);
  const pp=val('nm-p'),inv=$('#nm-inv');
  if(!(pp>0&&pp<1)){inv.innerHTML=warn('Enter an area strictly between 0 and 1.')}
  else{const z=invPhi(pp);inv.innerHTML=`<div class="results">${res('z score',fmt(z,3),1)}${res('x = μ + zσ',fmt(mu+z*sd,3),1)}</div>`}}

function buildZ(){
  let h='<thead><tr><th>z</th>'+Array.from({length:10},(_,j)=>`<th>${(j/100).toFixed(2).slice(1)}</th>`).join('')+'</tr></thead><tbody>';
  for(let i=0;i<=34;i++){h+=`<tr><td>${(i/10).toFixed(1)}</td>`+Array.from({length:10},(_,j)=>`<td>${Phi(i/10+j/100).toFixed(4)}</td>`).join('')+'</tr>'}
  $('#ztable').innerHTML=h+'</tbody>'}

const POPS={uni:{mu:50,sd:100/Math.sqrt(12),draw:()=>Math.random()*100},
            exp:{mu:20,sd:20,draw:()=>-20*Math.log(1-Math.random())},
            bi:{mu:50,sd:Math.sqrt(925),draw:()=>(Math.random()<.5?20:80)+5*randn()}};
let clt=null;
function runCLT(){
  const key=$('#clt-pop').value,P=POPS[key];const n=Math.floor(val('clt-n')),k=Math.floor(val('clt-k'));
  if(!(n>=1&&n<=200)||!(k>=50&&k<=5000)){$('#clt-out').innerHTML=warn('Use 1 ≤ n ≤ 200 and 50 ≤ samples ≤ 5000.');return}
  const means=[];for(let i=0;i<k;i++){let s=0;for(let j=0;j<n;j++)s+=P.draw();means.push(s/n)}
  const pop=[];for(let i=0;i<4000;i++)pop.push(P.draw());
  const mm=means.reduce((a,b)=>a+b,0)/k,osd=Math.sqrt(means.reduce((a,v)=>a+(v-mm)**2,0)/(k-1)),se=P.sd/Math.sqrt(n);
  const bins=(arr,lo,hi,nb)=>{const f=new Array(nb).fill(0);arr.forEach(v=>{f[Math.max(0,Math.min(nb-1,Math.floor((v-lo)/(hi-lo)*nb)))]++});return f};
  const mlo=P.mu-4*se,mhi=P.mu+4*se,nb=24;
  clt={pf:bins(pop,0,100,nb),pl:Array.from({length:nb},(_,i)=>String(Math.round(i*100/nb))),
       mf:bins(means,mlo,mhi,nb),ml:Array.from({length:nb},(_,i)=>fmt(mlo+i*(mhi-mlo)/nb,1))};
  $('#clt-out').innerHTML=`<div class="results">${res('Population mean μ',fmt(P.mu,2))}${res('Population SD σ',fmt(P.sd,2))}${res('Standard error σ/√n',fmt(se,3),1)}${res('Mean of the sample means',fmt(mm,3),1)}${res('SD of the sample means',fmt(osd,3),1)}</div>
   <p class="note">The mean of the sample means lands near μ, and their spread lands near σ/√n. Raise n and watch the bottom chart turn into a bell.</p>`;
  drawCLT()}
function drawCLT(){if(!clt)return;barChart($('#clt-c1'),clt.pl,clt.pf);barChart($('#clt-c2'),clt.ml,clt.mf)}

function runCI(){
  const out=$('#ci-out');const x=val('ci-x'),s=val('ci-s'),n=Math.floor(val('ci-n')),cl=val('ci-c'),type=$('#ci-type').value;
  if(![x,s].every(Number.isFinite)||!(s>=0)||!(n>=2)||!(cl>=50&&cl<100)){out.innerHTML=warn('Enter x̄, a non-negative SD, n ≥ 2 and a confidence level from 50 to 99.9.');return}
  const a=1-cl/100,crit=type==='z'?invPhi(1-a/2):tInv(1-a/2,n-1),se=s/Math.sqrt(n),me=crit*se;
  out.innerHTML=`<div class="results">${res(type==='z'?'Critical z':`Critical t (df ${n-1})`,fmt(crit,3))}${res('Standard error',fmt(se,4))}${res('Margin of error',fmt(me,4),1)}${res('Lower limit',fmt(x-me,3),1)}${res('Upper limit',fmt(x+me,3),1)}</div>
   <p class="note">We are ${fmt(cl,1)}% confident the population mean is between <b>${fmt(x-me,2)}</b> and <b>${fmt(x+me,2)}</b>.</p>
   <ol class="steps"><li>Margin of error = critical value × s / √n = <code>${fmt(crit,3)} × ${fmt(se,4)}</code></li></ol>`}

function runHT(){
  const out=$('#ht-out');const x=val('ht-x'),mu=val('ht-mu'),s=val('ht-s'),n=Math.floor(val('ht-n')),a=val('ht-a'),tail=$('#ht-tail').value,type=$('#ht-type').value;
  if(![x,mu,s].every(Number.isFinite)||!(s>0)||!(n>=2)||!(a>0&&a<1)){out.innerHTML=warn('Enter all values, with a positive SD, n ≥ 2 and 0 < α < 1.');return}
  const se=s/Math.sqrt(n),st=(x-mu)/se,df=n-1,cdf=v=>type==='z'?Phi(v):tCDF(v,df),inv=q=>type==='z'?invPhi(q):tInv(q,df);
  let p,crit,h1,words;
  if(tail==='two'){p=2*(1-cdf(Math.abs(st)));crit='±'+fmt(inv(1-a/2),3);h1=`μ ≠ ${fmt(mu)}`;words='different from'}
  else if(tail==='right'){p=1-cdf(st);crit=fmt(inv(1-a),3);h1=`μ > ${fmt(mu)}`;words='greater than'}
  else{p=cdf(st);crit=fmt(inv(a),3);h1=`μ < ${fmt(mu)}`;words='less than'}
  p=Math.min(1,Math.max(0,p));const rej=p<=a;
  out.innerHTML=`<p class="note" style="margin:0 0 8px"><code>H₀: μ = ${fmt(mu)}   H₁: ${h1}</code></p>
   <div class="results">${res(type==='z'?'Test statistic z':`Test statistic t (df ${df})`,fmt(st,3),1)}${res('p-value',fmtP(p),1)}${res('Critical value',crit)}${res('Standard error',fmt(se,4))}</div>
   <div class="verdict ${rej?'rej':'keep'}">${rej?`p ≤ α, so reject H₀. At α = ${fmt(a,3)} the sample gives enough evidence that the mean is ${words} ${fmt(mu)}.`:`p > α, so fail to reject H₀. At α = ${fmt(a,3)} the sample does not give enough evidence that the mean is ${words} ${fmt(mu)}.`}</div>`}

